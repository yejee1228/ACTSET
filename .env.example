# P-2 환경 분리 + 시크릿 관리
# 이 파일은 예시일 뿐이다. 실제 값은 .env(gitignore 대상)나 배포 환경의
# 시크릿 매니저(예: AWS Secrets Manager, GitHub Actions Secrets)에만 넣는다.
# CLAUDE.md 규칙: 시크릿은 코드·저장소에 절대 넣지 않는다.

# --- 프로필 (docs/09) ---
# 프로세스 역할(web|worker)과 환경(dev|staging|prod)은 별개 축이다.
# 예: SPRING_PROFILES_ACTIVE=web,prod
SPRING_PROFILES_ACTIVE=web,dev

# --- DB (필수) ---
DB_HOST=127.0.0.1
DB_PORT=55432
DB_NAME=actset
DB_USER=actset
DB_PASSWORD=

# --- 파일 저장소 (MVP는 로컬, 이후 S3로 교체) ---
STORAGE_ROOT=../storage
ACTSET_STORAGE_SIGNING_SECRET=

# --- 외부 API (0-1·0-1b·0-9 벤더 확정 전까지는 비워두고 목업으로 동작) ---
EXTERNAL_MOCK_MODE=true
# IDEOGRAM_API_KEY=
# QWEN_GPU_ENDPOINT=
# QWEN_GPU_API_KEY=
# AWS_SES_ACCESS_KEY_ID=
# AWS_SES_SECRET_ACCESS_KEY=
# AWS_SES_REGION=

# --- 비용·크레딧 임시값 (docs/06 단가 확정 전, OVERNIGHT-LOG 참고) ---
ACTSET_CREDIT_SIGNUP_GRANT=500
ACTSET_CREDIT_COST_PER_DRAFT_IMAGE=10
ACTSET_COST_HOURLY_GENERATION_LIMIT=10
ACTSET_COST_DAILY_API_BUDGET=500
