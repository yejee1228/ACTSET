# P-2 환경 분리 + 시크릿 관리
# 이 파일은 예시일 뿐이다. 실제 값은 .env(gitignore 대상)나 배포 환경의
# 시크릿 매니저(예: AWS Secrets Manager, GitHub Actions Secrets)에만 넣는다.
# CLAUDE.md 규칙: 시크릿은 코드·저장소에 절대 넣지 않는다.

# --- 프로필 (docs/09) ---
# 프로세스 역할(web|worker)과 환경(dev|staging|prod)은 별개 축이다.
# 예: SPRING_PROFILES_ACTIVE=web,prod
SPRING_PROFILES_ACTIVE=web,dev

# --- DB (필수) ---
DB_HOST=127.0.0.1
DB_PORT=55432
DB_NAME=actset
DB_USER=actset
DB_PASSWORD=

# --- 파일 저장소 (MVP는 로컬, 이후 S3로 교체) ---
STORAGE_ROOT=../storage
ACTSET_STORAGE_SIGNING_SECRET=

# --- 외부 API (0-1b·0-9 벤더 확정 전까지는 비워두고 목업으로 동작) ---
# 벤더별로 독립적이다 — 아래 키를 채운 벤더만 실제 어댑터로 자동 전환되고, 비워둔
# 벤더는 그대로 목업을 쓴다.
IDEOGRAM_API_KEY=
# TURBO(후보 생성) | DEFAULT | QUALITY(확정본 재생성) — docs/14 운용 전략
IDEOGRAM_RENDERING_SPEED=DEFAULT
# Ideogram에 보내기 전 긍정 프롬프트를 GPT가 먼저 다듬는다(GptPromptWritingAdapter).
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
# Gallery 부트스트래핑용 KOPIS(공연예술통합전산망) 공공API 시드(7-7, MVP 범위 밖 — 확인필요)
KOPIS_SERVICE_KEY=
# QWEN_GPU_ENDPOINT=
# QWEN_GPU_API_KEY=
# AWS_SES_ACCESS_KEY_ID=
# AWS_SES_SECRET_ACCESS_KEY=
# AWS_SES_REGION=

# --- 크레딧 임시값 (docs/06 단가 확정 전 — 일반 가입 20C/베타 참여자 50C는
#     관리자 지급으로 처리하므로 별도 env 없음) ---
ACTSET_CREDIT_SIGNUP_GRANT=20
